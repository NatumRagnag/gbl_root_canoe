## @file
# Standalone application decoder. Deliberately excludes GuidedSectionExtraction
# and its constructor: no protocol registration or platform fixed-address table.
# Uses the existing EDK2 LZMA SDK implementation without copying its sources.
# SPDX-License-Identifier: BSD-2-Clause-Patent
##
[Defines]
  INF_VERSION = 0x00010005
  BASE_NAME = RawLzmaDecompressLib
