  MODULE_TYPE = BASE
  VERSION_STRING = 1.0
  LIBRARY_CLASS = RawLzmaDecompressLib

[Sources]
  LzmaDecompress.c
  Sdk/C/LzmaDec.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
